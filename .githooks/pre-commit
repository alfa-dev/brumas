#!/bin/sh
# Guardrails de cache (GitHub Pages serve tudo com Cache-Control: max-age=600 e ignora a query string).
# A cada commit, carimba um BUILD novo em TODAS as referências a arquivos estáticos, para que o navegador
# nunca misture HTML/JS novos com CSS/imagens antigos. Ver "Cache" no AGENTS.md.
# Setup (uma vez por máquina): git config core.hooksPath .githooks

set -e

VERSION=$(git write-tree | cut -c1-7)

sed_inplace() {
  case "$(uname -s)" in
    Darwin) sed -i '' "$@" ;;
    *)      sed -i "$@" ;;
  esac
}

# 1) HTMLs da raiz: CSS, JS, imagens, vídeos e url() inline
find . -maxdepth 1 -name "*.html" ! -name "_*.html" | while read -r file; do
  sed_inplace -E \
    -e "s#(href=\"css/[^\"?]+\.css)(\?v=[^\"]*)?\"#\1?v=$VERSION\"#g" \
    -e "s#(src=\"js/[^\"?]+\.js)(\?v=[^\"]*)?\"#\1?v=$VERSION\"#g" \
    -e "s#((src|poster|data-src)=\"(assets|videos)/[^\"?]+)(\?v=[^\"]*)?\"#\1?v=$VERSION\"#g" \
    -e "s#url\((assets|videos)/([^)?]+)(\?v=[^)]*)?\)#url(\1/\2?v=$VERSION)#g" \
    "$file"
  git add "$file"
done

# 2) CSS: @import do styles.css e url() de imagens/vídeos em todos os arquivos
sed_inplace -E "s#@import '([^'?]+\.css)(\?v=[^']*)?'#@import '\1?v=$VERSION'#g" css/styles.css
find css -name "*.css" | while read -r file; do
  sed_inplace -E "s#url\(('?)([^')?]*(assets|videos)/[^')?]+)(\?v=[^')]*)?('?)\)#url(\1\2?v=$VERSION\5)#g" "$file"
  git add "$file"
done

# 3) JS: imagens/vídeos referenciados nos templates dos componentes
sed_inplace -E "s#((src|poster|data-src)=\"(assets|videos)/[^\"?]+)(\?v=[^\"]*)?\"#\1?v=$VERSION\"#g" js/components.js
git add js/components.js

# 4) Carimbo de build no CSS e no JS (o script.js compara os dois e recarrega o CSS se divergirem)
sed_inplace -E "s#--build: \"[^\"]*\";#--build: \"$VERSION\";#" css/base.css
sed_inplace -E "s#^const BUILD = '[^']*';#const BUILD = '$VERSION';#" js/script.js
git add css/base.css js/script.js

# 5) Verificações: falha o commit se sobrar referência sem versão
FAIL=0
if grep -nE "@import '[^']+\.css'" css/styles.css; then
  echo "[pre-commit] ERRO: @import sem ?v= em css/styles.css"; FAIL=1
fi
if grep -nE "(href=\"css/[^\"?]+\.css\"|src=\"js/[^\"?]+\.js\")" $(find . -maxdepth 1 -name "*.html" ! -name "_*.html"); then
  echo "[pre-commit] ERRO: CSS/JS sem ?v= nos HTMLs acima"; FAIL=1
fi
grep -q "^const BUILD = '$VERSION';" js/script.js || { echo "[pre-commit] ERRO: BUILD ausente em js/script.js"; FAIL=1; }
grep -q -- "--build: \"$VERSION\";" css/base.css || { echo "[pre-commit] ERRO: --build ausente em css/base.css"; FAIL=1; }
# CSS da raiz de css/ não pode subir dois níveis (funciona por http, quebra por file://)
if grep -nE "url\('?\.\./\.\./" css/*.css; then
  echo "[pre-commit] ERRO: url('../../') em css/*.css — use '../assets/' (arquivos da raiz de css/)"; FAIL=1
fi
[ "$FAIL" -eq 0 ] || exit 1

# 6) Aviso: imagens/vídeos substituídos mantendo o mesmo nome. Referências versionadas se atualizam, mas
#    as que não passam pelo hook (fotos da galeria em js/script.js, og:image absolutas) podem ficar velhas.
CHANGED=$(git diff --cached --name-only --diff-filter=M -- assets videos || true)
if [ -n "$CHANGED" ]; then
  echo "[pre-commit] AVISO: arquivos de mídia sobrescritos no mesmo nome:"
  echo "$CHANGED" | sed 's/^/    /'
  echo "    Prefira um nome novo (ex.: -v2) se forem usados em js/script.js ou em og:image."
fi

echo "[pre-commit] cache busting aplicado: BUILD=$VERSION"
